{
	"info": {
		"_postman_id": "quick-auxiliary-api-tests",
		"name": "RMS Auxiliary Features - Quick Tests",
		"description": "Simplified test collection for quick API validation",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{auth_token}}",
				"type": "string"
			}
		]
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://46.250.231.129:8080",
			"type": "string"
		},
		{
			"key": "auth_token",
			"value": "your_jwt_token_here",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Login",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"userName\": \"admin\",\n    \"password\": \"admin123\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/User/login",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"User",
						"login"
					]
				}
			}
		},
		{
			"name": "2. Get Favorites",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{auth_token}}"
					}
				],
				"url": {
					"raw": "{{base_url}}/api/Favorites",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"Favorites"
					]
				}
			}
		},
		{
			"name": "3. Add to Favorites",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{auth_token}}"
					}
				],
				"url": {
					"raw": "{{base_url}}/api/Favorites/F001",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"Favorites",
						"F001"
					]
				}
			}
		},
		{
			"name": "4. Get Order History",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{auth_token}}"
					}
				],
				"url": {
					"raw": "{{base_url}}/api/OrderHistory?page=1&pageSize=10",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"OrderHistory"
					],
					"query": [
						{
							"key": "page",
							"value": "1"
						},
						{
							"key": "pageSize",
							"value": "10"
						}
					]
				}
			}
		},
		{
			"name": "5. Create Order History",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{auth_token}}"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"orderId\": \"O001\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/OrderHistory",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"OrderHistory"
					]
				}
			}
		},
		{
			"name": "6. Get Reservations",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{auth_token}}"
					}
				],
				"url": {
					"raw": "{{base_url}}/api/ReservationHistory?page=1&pageSize=10",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"ReservationHistory"
					],
					"query": [
						{
							"key": "page",
							"value": "1"
						},
						{
							"key": "pageSize",
							"value": "10"
						}
					]
				}
			}
		},
		{
			"name": "7. Create Reservation",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{auth_token}}"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"tableId\": \"T001\",\n    \"reservationDate\": \"2024-12-15T00:00:00Z\",\n    \"reservationTime\": \"18:30:00\",\n    \"partySize\": 4,\n    \"note\": \"Quick test reservation\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/ReservationHistory",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"ReservationHistory"
					]
				}
			}
		}
	]
}