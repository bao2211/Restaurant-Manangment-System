{
  "name": "restaurant-management-mobile",
  "version": "1.0.0",
  "main": "index.js",
  "license": "0BSD",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:qlorder": "jest screens/__tests__/OrderFlow.web.test.js --runInBand --json --outputFile qlorder-jest-result.json",
    "test:qlorder:real": "jest screens/__tests__/OrderFlow.real-api.web.test.js --runInBand",
    "report:qlorder": "node scripts/update-qlorder-excel.js --result qlorder-jest-result.json --excel \"../../../../Selenium/Referances/IntegrationTestCase - Nhóm 04.xlsx\" --sheet \"IntegratedTestCases QLOrder\"",
    "test:qlorder:excel": "npm run test:qlorder && npm run report:qlorder",
    "export:web:scroll": "expo export --platform web && node scripts/patch-web-scroll.js",
    "build:android": "expo build:android",
    "build:ios": "expo build:ios"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-picker/picker": "2.11.1",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/stack": "^6.3.20",
    "axios": "^1.5.0",
    "expo": "~54.0.23",
    "expo-image-picker": "~17.0.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-print": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "^13.16.1"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.2.0",
    "exceljs": "^4.4.0",
    "jest": "^29.7.0",
    "jest-expo": "^54.0.11",
    "react-test-renderer": "19.1.0"
  }
}
