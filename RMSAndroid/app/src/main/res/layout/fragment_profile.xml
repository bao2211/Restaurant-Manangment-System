<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Modern Header with Gradient Background -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/gradient_header"
            android:paddingTop="@dimen/spacing_xlarge"
            android:paddingBottom="80dp"
            android:elevation="@dimen/elevation_normal">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="@dimen/spacing_normal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👤 Hồ sơ của tôi"
                    android:textSize="@dimen/text_xxlarge"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Thông tin tài khoản"
                    android:textSize="@dimen/text_normal"
                    android:textColor="#FFFFFF"
                    android:alpha="0.9"
                    android:layout_marginTop="@dimen/spacing_tiny"/>
            </LinearLayout>
        </RelativeLayout>

        <!-- Profile Card (overlapping header) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_normal"
            android:layout_marginEnd="@dimen/spacing_normal"
            android:layout_marginTop="-60dp"
            app:cardCornerRadius="@dimen/radius_large"
            app:cardElevation="@dimen/elevation_higher">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_large"
                android:gravity="center"
                android:background="@android:color/white">

                <!-- Circular Avatar -->
                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/iv_avatar"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:src="@android:drawable/ic_menu_myplaces"
                    android:background="#FF6B35"
                    android:padding="20dp"
                    app:civ_border_width="3dp"
                    app:civ_border_color="#FFFFFF"/>

                <TextView
                    android:id="@+id/tv_full_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tên người dùng"
                    android:textSize="@dimen/text_xlarge"
                    android:textStyle="bold"
                    android:textColor="#222222"
                    android:layout_marginTop="@dimen/spacing_normal"/>

                <TextView
                    android:id="@+id/tv_username"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@username"
                    android:textSize="@dimen/text_normal"
                    android:textColor="#999999"
                    android:layout_marginTop="@dimen/spacing_tiny"/>

                <!-- Role Badge -->
                <TextView
                    android:id="@+id/tv_role"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Khách hàng"
                    android:textSize="@dimen/text_small"
                    android:textStyle="bold"
                    android:textColor="#4CAF50"
                    android:background="#E8F5E9"
                    android:paddingStart="@dimen/spacing_normal"
                    android:paddingEnd="@dimen/spacing_normal"
                    android:paddingTop="@dimen/spacing_tiny"
                    android:paddingBottom="@dimen/spacing_tiny"
                    android:layout_marginTop="@dimen/spacing_normal"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Contact Information Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/spacing_normal"
            app:cardCornerRadius="@dimen/radius_large"
            app:cardElevation="@dimen/elevation_normal">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_normal"
                android:background="@android:color/white">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📧 Thông tin liên hệ"
                    android:textSize="@dimen/text_medium"
                    android:textStyle="bold"
                    android:textColor="#222222"
                    android:layout_marginBottom="@dimen/spacing_normal"/>

                <!-- Email Item -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/spacing_normal"
                    android:background="#F8F8F8"
                    android:layout_marginBottom="@dimen/spacing_small">

                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:text="✉️"
                        android:textSize="20sp"
                        android:gravity="center"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="@dimen/spacing_normal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Email"
                            android:textSize="@dimen/text_small"
                            android:textColor="#999999"/>

                        <TextView
                            android:id="@+id/tv_email"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="email@example.com"
                            android:textSize="@dimen/text_normal"
                            android:textColor="#333333"
                            android:textStyle="bold"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Phone Item -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/spacing_normal"
                    android:background="#F8F8F8">

                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:text="📱"
                        android:textSize="20sp"
                        android:gravity="center"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="@dimen/spacing_normal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Điện thoại"
                            android:textSize="@dimen/text_small"
                            android:textColor="#999999"/>

                        <TextView
                            android:id="@+id/tv_phone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0123456789"
                            android:textSize="@dimen/text_normal"
                            android:textColor="#333333"
                            android:textStyle="bold"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Actions Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_normal"
            android:layout_marginEnd="@dimen/spacing_normal"
            android:layout_marginBottom="@dimen/spacing_normal"
            app:cardCornerRadius="@dimen/radius_large"
            app:cardElevation="@dimen/elevation_normal">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_normal"
                android:background="@android:color/white">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚙️ Cài đặt"
                    android:textSize="@dimen/text_medium"
                    android:textStyle="bold"
                    android:textColor="#222222"
                    android:layout_marginBottom="@dimen/spacing_small"/>

                <!-- Logout Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_logout"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:text="🚪 Đăng xuất"
                    android:textSize="@dimen/text_medium"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:backgroundTint="#FF6B35"
                    app:cornerRadius="@dimen/radius_normal"
                    app:elevation="0dp"
                    app:rippleColor="#FF8555"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Bottom Spacing -->
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/spacing_normal"/>

    </LinearLayout>
</ScrollView>
